# Public values only: everything named EXPO_PUBLIC_ is built into the app and readable by anyone who has it.
# Never put the Supabase service role key, Gemini keys or Gmail secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Replace <your-pc-wifi-ip> with the IPv4 address from `ipconfig` on the PC (the same address Expo prints after `Metro: exp://`). Your PC's Wi-Fi address and the API port (not localhost: the phone is a different device). See docs/phase5-manual-checklist.md.
EXPO_PUBLIC_API_URL=http://<your-pc-wifi-ip>:4000
