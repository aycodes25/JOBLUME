{
  "name": "joblume-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file=../.env src/api/index.ts",
    "dev:worker": "tsx watch --env-file=../.env src/worker/index.ts",
    "dev": "concurrently -n api,worker -c blue,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/api/index.js",
    "start:worker": "node dist/worker/index.js",
    "pretest": "npm run build:shared --prefix ..",
    "pretypecheck": "npm run build:shared --prefix ..",
    "prebuild": "npm run build:shared --prefix ..",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "browsers:install": "playwright install chromium"
  },
  "dependencies": {
    "@joblume/shared": "*",
    "@supabase/supabase-js": "^2.118.0",
    "bullmq": "^5.81.5",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "pino": "^10.4.0",
    "playwright": "^1.64.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
