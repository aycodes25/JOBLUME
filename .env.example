# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
GEMINI_API_KEY=
# Verify against Google's current model list. Gemini 1.5 Flash has been retired.
GEMINI_MODEL=gemini-2.5-flash
# Optional fallback provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Soft daily cap on Gemini calls (free tier allows less than 1500). Default 200, set below your real quota.
AI_DAILY_LIMIT=200

# --- Queue (Upstash Redis, use the rediss:// URL) ---
UPSTASH_REDIS_URL=

# --- Security ---
# Log verbosity (pino): trace, debug, info, warn, error
# LOG_LEVEL=info
# SUPABASE_ANON_KEY and ENCRYPTION_KEY are validated at boot but not used until later phases.
# 32 random bytes as 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
WEB_ORIGIN=http://localhost:3000
PORT=4000

# --- Gmail sending (optional; see docs/gmail-setup.md) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# The API address Google redirects to after consent, for example http://localhost:4000/gmail/callback
GMAIL_REDIRECT_URI=

# --- Email finder (optional) ---
HUNTER_API_KEY=
# Free tier allows about 25 searches a month
HUNTER_MONTHLY_LIMIT=25

# --- LinkedIn and Indeed jobs through JSearch (optional; a RapidAPI key subscribed to JSearch) ---
JSEARCH_API_KEY=
# Requests per calendar month; the worker stops at this count until the next month
JSEARCH_MONTHLY_LIMIT=50

# --- Job scanning ---
# How often the job boards are scanned, in minutes (at least 30, default 120). Remotive stays at every 6 hours and JSearch at daily.
SCRAPE_EVERY_MINUTES=120

# --- Later phases (not used yet) ---
APOLLO_API_KEY=
RESEND_API_KEY=
